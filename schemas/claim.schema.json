{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pickyour.ai/schemas/applications/0.1.0/claim.schema.json",
  "title": "Standalone application claim shape",
  "description": "Exact v0.1.0 intake claim shape; semantic gates remain in validate_applications.py.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
    "subject": {"$ref": "#/$defs/subject"},
    "field": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "fact_type": {
      "enum": [
        "identity",
        "classification",
        "capability",
        "availability",
        "pricing",
        "privacy",
        "security",
        "compliance",
        "accessibility",
        "terms",
        "support",
        "integration",
        "performance",
        "lifecycle"
      ]
    },
    "value_status": {"enum": ["known", "unknown", "not_disclosed", "not_applicable", "disputed", "unsupported"]},
    "value": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "source_status": {"enum": ["unchecked", "checked"]},
    "verification_status": {"enum": ["unverified", "verified"]},
    "evidence_grade": {"enum": ["primary_documentation", "vendor_claim", "independent_measurement", "estimate"]},
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
      "minItems": 0,
      "uniqueItems": true
    },
    "checked_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "temporal_scope": {"enum": ["current_state", "version_pinned"]},
    "version": {"type": ["string", "null"], "minLength": 1},
    "as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "scope": {
      "type": "object",
      "properties": {
        "offering_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
        "region": {"type": ["string", "null"], "minLength": 1},
        "locale": {"type": ["string", "null"], "minLength": 1},
        "platform": {"type": ["string", "null"], "minLength": 1},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0, "uniqueItems": true}
      },
      "required": ["offering_id", "region", "locale", "platform", "conditions"],
      "additionalProperties": false
    },
    "evidence_state": {"enum": ["active", "recheck_required", "withdrawn", "superseded"]},
    "explicit_negative_evidence": {"type": "boolean"},
    "researcher": {"type": "string", "minLength": 1},
    "review": {"$ref": "#/$defs/review"},
    "verification": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/verification"}]},
    "method_and_limitations": {"type": ["string", "null"], "minLength": 1}
  },
  "required": [
    "id",
    "subject",
    "field",
    "fact_type",
    "value_status",
    "value",
    "source_status",
    "verification_status",
    "evidence_grade",
    "source_ids",
    "checked_on",
    "temporal_scope",
    "version",
    "as_of",
    "scope",
    "evidence_state",
    "explicit_negative_evidence",
    "researcher",
    "review",
    "verification",
    "method_and_limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "subject": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
        "entity_type": {
          "enum": [
            "application_product",
            "product_family",
            "application_release",
            "application_offering",
            "application_feature",
            "integration",
            "model",
            "vendor"
          ]
        }
      },
      "required": ["id", "entity_type"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "reviewer": {"type": ["string", "null"], "minLength": 1},
        "reviewed_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "decision_url": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["status", "reviewer", "reviewed_on", "decision_url"],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "method": {"enum": ["reproduced_test", "independent_second_source"]},
        "independent": {"type": "boolean"},
        "verifier": {"type": "string", "minLength": 1},
        "verified_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "receipt_url": {"type": "string", "minLength": 1},
        "protocol_version": {"type": ["string", "null"], "minLength": 1},
        "source_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
        "limitations": {"type": "string", "minLength": 1}
      },
      "required": [
        "method",
        "independent",
        "verifier",
        "verified_on",
        "receipt_url",
        "protocol_version",
        "source_id",
        "limitations"
      ],
      "additionalProperties": false
    }
  }
}
