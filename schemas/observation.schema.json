{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pickyour.ai/schemas/applications/proposals/0.1.0/observation.schema.json",
  "title": "Proposed observation sidecar; not an admitted application record",
  "description": "A checked or failed-access attempt with immutable history links. No publication grant or product verification follows from this shape.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1.0-proposal"},
    "entity_type": {"const": "application_observation_proposal"},
    "synthetic": {"type": "boolean"},
    "id": {"type": "string", "pattern": "^observation:[a-z0-9][a-z0-9._/-]*$"},
    "researcher": {"type": "string", "minLength": 1},
    "subject": {"$ref": "#/$defs/subject"},
    "field": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "scope": {
      "type": "object",
      "properties": {
        "offering_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
        "region": {"type": ["string", "null"], "minLength": 1},
        "locale": {"type": ["string", "null"], "minLength": 1},
        "platform": {"type": ["string", "null"], "minLength": 1},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0, "uniqueItems": true}
      },
      "required": ["offering_id", "region", "locale", "platform", "conditions"],
      "additionalProperties": false
    },
    "temporal_scope": {"enum": ["current_state", "version_pinned"]},
    "version": {"type": ["string", "null"], "minLength": 1},
    "release_channel": {"type": ["string", "null"], "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "source_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
    "attempted_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "outcome": {"enum": ["checked", "failed_access"]},
    "checked_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "access_note": {"type": "string", "minLength": 1},
    "claim_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
      "uniqueItems": true
    },
    "evidence_state": {"enum": ["active", "disputed", "superseded", "withdrawn"]},
    "supersedes_observation_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^observation:[a-z0-9][a-z0-9._/-]*$"},
      "uniqueItems": true
    },
    "disputes_observation_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^observation:[a-z0-9][a-z0-9._/-]*$"},
      "uniqueItems": true
    },
    "review": {"$ref": "#/$defs/review"},
    "limitations": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "entity_type",
    "synthetic",
    "id",
    "researcher",
    "subject",
    "field",
    "scope",
    "temporal_scope",
    "version",
    "release_channel",
    "source_locator",
    "source_id",
    "attempted_on",
    "outcome",
    "checked_on",
    "access_note",
    "claim_ids",
    "evidence_state",
    "supersedes_observation_ids",
    "disputes_observation_ids",
    "review",
    "limitations"
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
        "entity_type": {
          "enum": [
            "application_product",
            "product_family",
            "application_release",
            "application_offering",
            "application_feature",
            "integration",
            "model",
            "vendor"
          ]
        }
      },
      "required": ["id", "entity_type"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "reviewer": {"type": ["string", "null"], "minLength": 1},
        "reviewed_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "decision_url": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["status", "reviewer", "reviewed_on", "decision_url"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "failed_access"}}, "required": ["outcome"]},
      "then": {"properties": {"checked_on": {"type": "null"}, "source_id": {"type": "null"}, "claim_ids": {"const": []}}},
      "else": {
        "properties": {
          "checked_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
          "claim_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"},
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {"properties": {"temporal_scope": {"const": "version_pinned"}}, "required": ["temporal_scope"]},
      "then": {"properties": {"version": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"evidence_state": {"const": "disputed"}}, "required": ["evidence_state"]},
      "then": {
        "properties": {
          "disputes_observation_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^observation:[a-z0-9][a-z0-9._/-]*$"},
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  ]
}
