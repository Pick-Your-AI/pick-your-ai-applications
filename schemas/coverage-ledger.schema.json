{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pick-your-ai.example/schemas/coverage-ledger/0.1.0",
  "title": "Local coverage counter envelope; membership requires semantic validation",
  "type": "object",
  "required": ["schema_version", "snapshot_date", "rows"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "snapshot_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "row": {
      "type": "object",
      "required": ["category_id", "candidate_sightings_count", "deduplicated_product_count", "offering_count", "primary_sourced_product_count", "reviewed_product_count", "independently_measured_product_count", "publication_eligible_product_count", "published_product_count"],
      "properties": {
        "category_id": {"type": "string", "pattern": "^APP-C[0-9]{2}$"},
        "candidate_sightings_count": {"$ref": "#/$defs/count"},
        "deduplicated_product_count": {"$ref": "#/$defs/count"},
        "offering_count": {"$ref": "#/$defs/count"},
        "primary_sourced_product_count": {"$ref": "#/$defs/count"},
        "reviewed_product_count": {"$ref": "#/$defs/count"},
        "independently_measured_product_count": {"$ref": "#/$defs/count"},
        "publication_eligible_product_count": {"$ref": "#/$defs/count"},
        "published_product_count": {"$ref": "#/$defs/count"}
      }
    }
  }
}
